      "unlockedTier": "LEVEL_1",
      "averageMonthlyIncome": "$1,950",
      "lowestMonthlyIncome": "$1,700",
      "lowestIncomeMonth": "2026-08",
      "provenMonthlySaving": "$75",
      "monthsSaved": "4 of 4",
      "safeMonthlyInstalmentCap": "$150",
      "requestedLoanAmount": "$1,200",
      "requestedTermMonths": 8,
      "suggestedLoanAmount": "$1,200",
      "suggestedTermMonths": 8,
      "suggestedMonthlyInstalment": "$150",
      "purpose": "Used commercial sewing machine"
    },
    "expected": {
      "mustIncludeDollars": ["$1,950", "$75", "$1,200", "$150"],
      "mustNotContain": ["FICO", "credit score", "late fee", "APR", "penalty"]
    }
