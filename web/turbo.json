{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["SEED_API_URL", "SEED_INTERNAL_TOKEN", "SESSION_SECRET", "NEXT_PUBLIC_PAYPAL_CLIENT_ID"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
