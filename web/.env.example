# Copy to apps/member/.env.local and apps/desk/.env.local (both apps read the same variables).

# Backend base URL (the Java app, started with SPRING_PROFILES_ACTIVE=demo,dev).
SEED_API_URL=http://localhost:8080

# Service token for /internal/** (demo seeding on the member app, operations on the desk).
# Must match the backend's seed.security.internal-token. Server-only: never exposed to the browser.
SEED_INTERNAL_TOKEN=local-dev-internal-token

# Signs the session cookie (HMAC-SHA256). Required in production; use 32+ random bytes.
SESSION_SECRET=change-me-to-a-long-random-string

# Member app: signs the short tokens the backend expects (ADR 0016): kid:secret with 32 or more characters of secret.
# Same value as the backend. Required in production. Unset locally, the apps send dev headers, which only dev and demo
# profiles read.
SEED_ACTOR_TOKEN_SECRETS=

# Desk: its own key for staff tokens and its own token for staff logins and accounts (ADR 0023), so the member app can
# never act as staff. Same values as the backend; both required in production, and the key must differ from
# SEED_ACTOR_TOKEN_SECRETS. Locally the desk uses SEED_ACTOR_TOKEN_SECRETS and local-dev-staff-service-token.
SEED_STAFF_ACTOR_TOKEN_SECRETS=
SEED_STAFF_SERVICE_TOKEN=

# How many proxies in front of the app append to X-Forwarded-For (default 1). Login rate limits read the client
# address from it; raise it if a CDN sits in front, set 0 when nothing does.
# SEED_TRUSTED_PROXY_HOPS=1

# Ana's story, the member id box and the desk personas let anyone in without a password. On by default outside
# production and off in production; set true only for a demo deployment.
# SEED_DEMO_LOGIN=false

# Member app: Log in with PayPal. The secret stays on this server. PayPal must have
# ${APP_ORIGIN}/api/auth/paypal/callback saved as a return URL.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:3000

# Optional: PayPal sandbox client id for the member "Pay now" buttons and the public /fund Donate buttons. Hidden when unset.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Member app: Channel3 product search for "Save for something" (/app/shop). Optional and server-only; without it the
# shop shows a small, labelled list of demo products.
CHANNEL3_API_KEY=

# Member app, optional: public developers page (/developers). API host shown in the code snippets (placeholder when
# unset) and the APIMatic portal link (the button is hidden when unset).
NEXT_PUBLIC_PUBLIC_API_URL=
NEXT_PUBLIC_PORTAL_URL=
